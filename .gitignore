# Segredos: só o modelo vai para o Git. O .env.schema do varlock (apps/web) só tem nomes e
# valores públicos, então também vai.
.env
.env.*
!.env.example
!.env.schema

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/

# Front
node_modules/
.vite/
.turbo/
.output/
.nitro/
.tanstack/
*.tsbuildinfo
coverage/
*.log
# Gerados no build e na instalação do front
apps/web/src/routeTree.gen.ts
apps/web/src/env.ts

# As pastas de trabalho do Impeccable. Ficam no git os briefs, em surfaces/, o
# critique/ignore.md, o live/config.json, o config.json e o design.json.
**/.impeccable/review/
**/.impeccable/critique/*
!**/.impeccable/critique/ignore.md
**/.impeccable/live/*
!**/.impeccable/live/config.json

# Builds
dist/
build/

# Dados baixados e páginas coletadas (ZIPs do TSE, respostas brutas)
data/

# Configuração pessoal de agentes e editores
.claude/settings.local.json
CLAUDE.local.md
.idea/
.vscode/

# Sistema
.DS_Store
Thumbs.db
