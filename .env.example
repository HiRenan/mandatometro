# Modelo do .env: copie com `cp .env.example .env` e preencha.
# O .env fica fora do Git. Este arquivo só tem nomes e valores de exemplo.

# --- Banco (Docker Compose local) ---
POSTGRES_DB=mandatometro
POSTGRES_USER=mandatometro
POSTGRES_PASSWORD=troque-esta-senha
# O banco do Compose atende na porta 5433 do computador; a 5432 fica livre para um PostgreSQL instalado.
DATABASE_URL=postgresql+psycopg://mandatometro:troque-esta-senha@localhost:5433/mandatometro
# Hospedagem: URL direta do Neon, sem pool. No Actions, é um secret por ambiente;
# o workflow a entrega como DATABASE_URL somente à migration. Nunca vai para o site.
DATABASE_URL_UNPOOLED=
# Variável do repositório no GitHub, não da API: true liga a coleta diária da produção.
# Deixe ausente até publicar os conectores na main e concluir a primeira carga.
COLETAS_ATIVAS=
# Variável do repositório no GitHub: true liga apenas o envio de domingo.
# Independente de COLETAS_ATIVAS; vazio/ausente deixa o envio agendado desligado.
ENVIOS_ATIVOS=

# --- Firecrawl: leitura da página de destaques do DOU pela exceção do ADR 0006 ---
FIRECRAWL_API_KEY=

# --- INLABS: download dos XMLs do Diário Oficial da União (ADR 0004) ---
# O INLABS (inlabs.in.gov.br) é o serviço de dados abertos da Imprensa Nacional.
# O cadastro é gratuito e o download dos XMLs exige login.
# A configuração lê estas variáveis, reservadas para a integração com o INLABS.
# A coleta dos destaques usa FIRECRAWL_API_KEY (ADR 0006).
INLABS_USUARIO=
INLABS_SENHA=

# --- ElevenLabs: a narração do Jogo das Comissões ---
# Só é usada na hora de gravar as vozes, pelo `pnpm --filter web vozes`, e não
# vai para o site nem para a API. O plano gratuito não sintetiza pela API:
# precisa de um plano pago para gerar os arquivos de vo/.
ELEVENLABS_API_KEY=

# --- Resend: a newsletter e a última edição para quem se inscreve ---
RESEND_API_KEY=
# O domínio mandatometro.com.br foi verificado em 13/11/2026. O Renan escolhe
# um endereço desse domínio e troca o exemplo abaixo, que não é segredo.
# O remetente de teste só entrega no e-mail do dono da conta do Resend.
RESEND_FROM="Mandatômetro <onboarding@resend.dev>"
# Cota global de tentativas de inscrição por minuto; vazio usa o padrão 30.
NEWSLETTER_LIMITE_POR_MINUTO=

# --- Medição do piloto ---
# Use true para abrir a coleta. Vazio mantém o piloto desligado.
PILOTO_ATIVO=
# Último dia de coleta em Brasília (AAAA-MM-DD, inclusive). Vazio usa apenas PILOTO_ATIVO.
PILOTO_ATE=
# Cota global por minuto, independente da newsletter; vazio usa 120.
PILOTO_LIMITE_POR_MINUTO=

# --- Redator da edição semanal (no computador de quem revisa) ---
# Para usar IA, preencha com anthropic, um modelo como claude-opus-5-5 e a chave da API.
# Crie a chave no Claude Console para um único workspace do time.
# Deixe LLM_PROVIDER vazio ou só com espaços para redação manual.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# --- App ---
# Endereço do site: a API libera o CORS para ele, e o site põe ele na frente da
# imagem da prévia do link (og:image). O Docker Compose passa para o build do site;
# no `pnpm dev` vale o padrão de apps/web/.env.schema. Na Vercel, o .env.schema
# escolhe pelo VERCEL_ENV; noutra hospedagem, use o do domínio.
# A newsletter também usa esse endereço no link para sair.
APP_BASE_URL=http://localhost:3001
# Endereço da API visto pelo navegador. O Docker Compose passa para o build do site;
# no `pnpm dev` vale o padrão de apps/web/.env.schema. Na Vercel, fica vazio por
# padrão: ative em Production e no Preview só da develop (docs/hospedagem.md).
# Sem ele, o site não mostra a inscrição na newsletter.
# A newsletter também usa esse endereço no cabeçalho List-Unsubscribe.
# Para envio real, APP_BASE_URL e API_URL precisam ser HTTPS e acessíveis ao destinatário.
API_URL=http://localhost:8000
# A própria Vercel define 1. Na API, exige DATABASE_URL e usa o pool do Neon,
# sem manter outro pool na função. Fora da Vercel, deixe vazio.
VERCEL=
# O ambiente (production ou preview) e o endereço da branch, que a própria Vercel
# define no build do site. Ficam vazios fora dela.
VERCEL_ENV=
VERCEL_BRANCH_URL=

# Chave Fernet privada para avisos de conta e cotas. Use a mesma na API e no job.
CONTA_CHAVE=
# Versão e endereço público do termo de consentimento. Vazio mantém o cadastro
# fechado. A versão é a VERSAO_DO_TERMO de apps/web/src/lib/termo.ts. Na troca,
# publique primeiro a API com a nova versão. O cadastro reabre quando o site com
# o novo texto e a mesma versão for publicado (docs/hospedagem.md).
# O endereço é o /termo do site, como http://localhost:3001/termo.
CONTA_TERMO_VERSAO=
CONTA_TERMO_URL=
