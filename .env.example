# Modelo do .env: copie com `cp .env.example .env` e preencha.
# O .env fica fora do Git. Este arquivo só tem nomes e valores de exemplo.

# --- Banco (Docker Compose local) ---
POSTGRES_DB=mandatometro
POSTGRES_USER=mandatometro
POSTGRES_PASSWORD=troque-esta-senha
# O banco do Compose atende na porta 5433 do computador; a 5432 fica livre para um PostgreSQL instalado.
DATABASE_URL=postgresql+psycopg://mandatometro:troque-esta-senha@localhost:5433/mandatometro

# --- Firecrawl: leitura de páginas e PDFs (em teste na issue #9) ---
FIRECRAWL_API_KEY=

# --- Resend: a newsletter e a última edição para quem se inscreve ---
RESEND_API_KEY=
# Sem domínio verificado no Resend, use o remetente de teste abaixo:
# ele só entrega no e-mail do dono da conta do Resend. Com o mandatometro.com.br
# verificado (issue #32), use um endereço do domínio.
RESEND_FROM="Mandatômetro <onboarding@resend.dev>"

# --- Devin: só se o código chamar a API do Devin ---
# O uso normal é pelo app do Devin ligado ao GitHub, sem chave aqui.
DEVIN_API_KEY=

# --- LLM: provedor ainda em aberto (issue #1) ---
# Bedrock: deixe LLM_API_KEY vazio e use as credenciais da AWS (AWS_PROFILE e AWS_REGION).
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
# Embeddings podem vir de outro provedor.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# --- App ---
# Endereço do site: a API libera o CORS para ele, e o site põe ele na frente da
# imagem da prévia do link (og:image). O Docker Compose passa para o build do site;
# no `pnpm dev` vale o padrão de apps/web/.env.schema. No ar, use o do domínio.
APP_BASE_URL=http://localhost:3001
# Endereço da API visto pelo navegador. O Docker Compose passa para o build do site;
# no `pnpm dev` vale o padrão de apps/web/.env.schema.
API_URL=http://localhost:8000
