# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Endereço da API (FastAPI) chamada pelo navegador. É público e entra no build.
# @public @type=url
API_URL=http://localhost:8000

# Endereço do site, o mesmo que a API libera no CORS. A prévia do link (og:image)
# leva o endereço completo da imagem, com este na frente: no ar, use o do domínio.
# É público e entra no build.
# @public @type=url
APP_BASE_URL=http://localhost:3001
