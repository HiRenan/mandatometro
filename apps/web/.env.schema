# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Endereço da API (FastAPI) chamada pelo navegador. É público e entra no build.
# @public @type=url
API_URL=http://localhost:8000

# O ambiente da Vercel, que ela mesma define no build: production na main e
# preview na develop e nos PRs. Fora da Vercel, fica vazio. Fora da produção, as
# páginas pedem aos buscadores para não indexar (routes/__root.tsx).
# @public @optional @type=enum(development, preview, production)
VERCEL_ENV=

# O endereço da branch na Vercel, sem o https://, que ela mesma define no build,
# como mandatometro-git-develop-<conta>.vercel.app.
# @public @optional
VERCEL_BRANCH_URL=

# Endereço do site, o mesmo que a API libera no CORS. A prévia do link (og:image)
# leva o endereço completo da imagem, com este na frente. Na Vercel, é o domínio
# na produção e o endereço da branch nas prévias e na develop; fora dela, o do
# pnpm dev. Um APP_BASE_URL no ambiente vale mais, como no Docker.
# É público e entra no build.
# @public @type=url
APP_BASE_URL=remap($VERCEL_ENV, production, "https://mandatometro.com.br", preview, concat("https://", $VERCEL_BRANCH_URL), "http://localhost:3001")
