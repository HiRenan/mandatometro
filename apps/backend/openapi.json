{
  "openapi": "3.1.0",
  "info": {
    "title": "Mandatômetro",
    "version": "0.1.0"
  },
  "paths": {
    "/newsletter/inscricoes": {
      "post": {
        "tags": [
          "newsletter"
        ],
        "summary": "Receber a inscrição e enviar a última edição publicada",
        "description": "Novo e repetido têm a mesma resposta. edicao_enviada confirma a aceitação pelo Resend, não a entrega na caixa postal. Nas outras situações a inscrição também fica gravada.",
        "operationId": "inscrever_newsletter",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PedidoInscricao"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultadoInscricao"
                }
              }
            }
          },
          "422": {
            "description": "Dados inválidos, sem repetir a entrada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroNewsletter"
                }
              }
            }
          },
          "503": {
            "description": "Operação no banco não confirmada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroNewsletter"
                }
              }
            }
          },
          "429": {
            "description": "Cota global por minuto atingida.",
            "headers": {
              "Retry-After": {
                "description": "Segundos para tentar novamente.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroNewsletter"
                }
              }
            }
          }
        }
      }
    },
    "/newsletter/saida/{codigo_saida}": {
      "post": {
        "tags": [
          "newsletter"
        ],
        "summary": "Apagar a inscrição pelo código de saída",
        "description": "POST idempotente, sem autenticação ou corpo obrigatório. Aceita RFC 8058 e a confirmação no site; o corpo é ignorado. Código desconhecido também recebe 200 vazio.",
        "operationId": "sair_da_newsletter",
        "parameters": [
          {
            "name": "codigo_saida",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Codigo Saida"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Dados inválidos, sem repetir a entrada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroNewsletter"
                }
              }
            }
          },
          "503": {
            "description": "Operação no banco não confirmada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroNewsletter"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "newsletter"
        ],
        "summary": "Abrir a página de confirmação de saída, sem apagar a inscrição",
        "operationId": "abrir_saida",
        "parameters": [
          {
            "name": "codigo_saida",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Codigo Saida"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Dados inválidos, sem repetir a entrada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroNewsletter"
                }
              }
            }
          },
          "503": {
            "description": "Operação no banco não confirmada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroNewsletter"
                }
              }
            }
          }
        }
      }
    },
    "/edicoes": {
      "get": {
        "tags": [
          "edicoes"
        ],
        "summary": "Listar as edições publicadas",
        "operationId": "listar_edicoes",
        "parameters": [
          {
            "name": "limite",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limite"
            }
          },
          {
            "name": "deslocamento",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Deslocamento"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListaEdicoes"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroEdicaoPublica"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroEdicaoPublica"
                }
              }
            },
            "description": "Service Unavailable"
          }
        }
      }
    },
    "/edicoes/{id}": {
      "get": {
        "tags": [
          "edicoes"
        ],
        "summary": "Ler uma edição publicada com fatos, fontes e artigos da trilha",
        "operationId": "obter_edicao",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "title": "Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EdicaoPublica"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroEdicaoPublica"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroEdicaoPublica"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroEdicaoPublica"
                }
              }
            },
            "description": "Not Found"
          }
        }
      }
    },
    "/piloto/tentativas": {
      "post": {
        "tags": [
          "piloto"
        ],
        "summary": "Receber a primeira conclusão de uma etapa do piloto",
        "description": "O mesmo código nas duas etapas permite parear resultados; códigos diferentes permitem apenas médias independentes. Reenvios não alteram a primeira conclusão. Novo e repetido recebem a mesma resposta, sem revelar acertos ou existência anterior.",
        "operationId": "registrar_tentativa_piloto",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PedidoTentativaPiloto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultadoTentativaPiloto"
                }
              }
            }
          },
          "410": {
            "description": "Piloto desabilitado, sem gravação.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroPiloto"
                }
              }
            }
          },
          "413": {
            "description": "Corpo maior que 2 KiB.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroPiloto"
                }
              }
            }
          },
          "422": {
            "description": "Dados inválidos, sem repetir a entrada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroPiloto"
                }
              }
            }
          },
          "429": {
            "description": "Cota global por minuto atingida.",
            "headers": {
              "Retry-After": {
                "description": "Segundos para tentar novamente.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroPiloto"
                }
              }
            }
          },
          "503": {
            "description": "Operação no banco não confirmada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroPiloto"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "saude"
        ],
        "summary": "Health",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Saude"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ArtigoDaEdicao": {
        "properties": {
          "titulo": {
            "type": "string",
            "title": "Titulo"
          },
          "caminho": {
            "type": "string",
            "title": "Caminho"
          }
        },
        "type": "object",
        "required": [
          "titulo",
          "caminho"
        ],
        "title": "ArtigoDaEdicao"
      },
      "EdicaoPublica": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "titulo": {
            "type": "string",
            "title": "Titulo"
          },
          "inicio": {
            "type": "string",
            "format": "date",
            "title": "Inicio"
          },
          "fim": {
            "type": "string",
            "format": "date",
            "title": "Fim"
          },
          "publicada_em": {
            "type": "string",
            "format": "date-time",
            "title": "Publicada Em"
          },
          "itens": {
            "items": {
              "$ref": "#/components/schemas/ItemPublico"
            },
            "type": "array",
            "title": "Itens"
          }
        },
        "type": "object",
        "required": [
          "id",
          "titulo",
          "inicio",
          "fim",
          "publicada_em",
          "itens"
        ],
        "title": "EdicaoPublica"
      },
      "ErroEdicaoPublica": {
        "properties": {
          "erro": {
            "type": "string",
            "enum": [
              "dados_invalidos",
              "edicao_nao_encontrada",
              "servico_indisponivel"
            ],
            "title": "Erro"
          }
        },
        "type": "object",
        "required": [
          "erro"
        ],
        "title": "ErroEdicaoPublica"
      },
      "ErroNewsletter": {
        "properties": {
          "erro": {
            "type": "string",
            "enum": [
              "dados_invalidos",
              "limite_de_inscricoes",
              "servico_indisponivel"
            ],
            "title": "Erro"
          }
        },
        "type": "object",
        "required": [
          "erro"
        ],
        "title": "ErroNewsletter"
      },
      "ErroPiloto": {
        "properties": {
          "erro": {
            "type": "string",
            "enum": [
              "dados_invalidos",
              "corpo_muito_grande",
              "limite_de_tentativas",
              "servico_indisponivel",
              "piloto_encerrado"
            ],
            "title": "Erro"
          }
        },
        "type": "object",
        "required": [
          "erro"
        ],
        "title": "ErroPiloto"
      },
      "FatosPublicos": {
        "properties": {
          "votacoes": {
            "items": {
              "$ref": "#/components/schemas/VotacaoPublica"
            },
            "type": "array",
            "title": "Votacoes"
          }
        },
        "type": "object",
        "required": [
          "votacoes"
        ],
        "title": "FatosPublicos"
      },
      "FontePublica": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          },
          "coletado_em": {
            "type": "string",
            "format": "date-time",
            "title": "Coletado Em"
          },
          "trecho": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trecho"
          }
        },
        "type": "object",
        "required": [
          "url",
          "coletado_em",
          "trecho"
        ],
        "title": "FontePublica"
      },
      "ItemPublico": {
        "properties": {
          "ordem": {
            "type": "integer",
            "title": "Ordem"
          },
          "titulo": {
            "type": "string",
            "title": "Titulo"
          },
          "texto": {
            "type": "string",
            "title": "Texto"
          },
          "fatos": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FatosPublicos"
              },
              {
                "type": "null"
              }
            ]
          },
          "fontes": {
            "items": {
              "$ref": "#/components/schemas/FontePublica"
            },
            "type": "array",
            "title": "Fontes"
          },
          "artigo": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ArtigoDaEdicao"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "ordem",
          "titulo",
          "texto",
          "fatos",
          "fontes",
          "artigo"
        ],
        "title": "ItemPublico"
      },
      "ListaEdicoes": {
        "properties": {
          "edicoes": {
            "items": {
              "$ref": "#/components/schemas/ResumoEdicao"
            },
            "type": "array",
            "title": "Edicoes"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limite": {
            "type": "integer",
            "title": "Limite"
          },
          "deslocamento": {
            "type": "integer",
            "title": "Deslocamento"
          }
        },
        "type": "object",
        "required": [
          "edicoes",
          "total",
          "limite",
          "deslocamento"
        ],
        "title": "ListaEdicoes"
      },
      "PedidoInscricao": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 320,
            "format": "email",
            "title": "Email",
            "description": "Somente o endereço de e-mail."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email"
        ],
        "title": "PedidoInscricao"
      },
      "PedidoTentativaPiloto": {
        "properties": {
          "participacao": {
            "type": "string",
            "format": "uuid4",
            "title": "Participacao",
            "description": "Código aleatório do piloto, sem relação com conta."
          },
          "versao_quiz": {
            "type": "string",
            "const": "processo-legislativo-final-v1",
            "title": "Versao Quiz"
          },
          "etapa": {
            "type": "string",
            "enum": [
              "antes",
              "depois"
            ],
            "title": "Etapa"
          },
          "acertos": {
            "type": "integer",
            "maximum": 12.0,
            "minimum": 0.0,
            "title": "Acertos"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "participacao",
          "versao_quiz",
          "etapa",
          "acertos"
        ],
        "title": "PedidoTentativaPiloto"
      },
      "PlacarPublico": {
        "properties": {
          "sim": {
            "type": "integer",
            "title": "Sim"
          },
          "nao": {
            "type": "integer",
            "title": "Nao"
          },
          "abstencao": {
            "type": "integer",
            "title": "Abstencao"
          },
          "obstrucao": {
            "type": "integer",
            "title": "Obstrucao"
          },
          "presidente": {
            "type": "integer",
            "title": "Presidente"
          }
        },
        "type": "object",
        "required": [
          "sim",
          "nao",
          "abstencao",
          "obstrucao",
          "presidente"
        ],
        "title": "PlacarPublico"
      },
      "ResultadoInscricao": {
        "properties": {
          "situacao": {
            "type": "string",
            "enum": [
              "edicao_enviada",
              "aguardando_edicao",
              "envio_indisponivel"
            ],
            "title": "Situacao"
          }
        },
        "type": "object",
        "required": [
          "situacao"
        ],
        "title": "ResultadoInscricao"
      },
      "ResultadoTentativaPiloto": {
        "properties": {
          "situacao": {
            "type": "string",
            "const": "recebida",
            "title": "Situacao"
          }
        },
        "type": "object",
        "required": [
          "situacao"
        ],
        "title": "ResultadoTentativaPiloto"
      },
      "ResumoEdicao": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "titulo": {
            "type": "string",
            "title": "Titulo"
          },
          "inicio": {
            "type": "string",
            "format": "date",
            "title": "Inicio"
          },
          "fim": {
            "type": "string",
            "format": "date",
            "title": "Fim"
          },
          "publicada_em": {
            "type": "string",
            "format": "date-time",
            "title": "Publicada Em"
          }
        },
        "type": "object",
        "required": [
          "id",
          "titulo",
          "inicio",
          "fim",
          "publicada_em"
        ],
        "title": "ResumoEdicao"
      },
      "Saude": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Saude"
      },
      "VotacaoPublica": {
        "properties": {
          "data": {
            "type": "string",
            "format": "date",
            "title": "Data"
          },
          "resultado": {
            "type": "string",
            "enum": [
              "aprovada",
              "rejeitada",
              "outro"
            ],
            "title": "Resultado"
          },
          "placar": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PlacarPublico"
              },
              {
                "type": "null"
              }
            ]
          },
          "fontes": {
            "items": {
              "$ref": "#/components/schemas/FontePublica"
            },
            "type": "array",
            "title": "Fontes"
          }
        },
        "type": "object",
        "required": [
          "data",
          "resultado",
          "placar",
          "fontes"
        ],
        "title": "VotacaoPublica"
      }
    }
  }
}
